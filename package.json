{
  "name": "tp-unitarios-node-jest",
  "version": "1.0.0",
  "private": true,
  "description": "TP autoguiado de pruebas unitarias con Node.js y Jest",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": { "jest": "30.2.0" },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"]
  }
}
